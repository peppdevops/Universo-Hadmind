POSTGRES_DB=hadmind
POSTGRES_USER=hadmind
POSTGRES_PASSWORD=cambia-esto
POSTGRES_HOST=db
POSTGRES_PORT=5432

DJANGO_SECRET_KEY=cambia-esto
# 1 = desarrollo, 0 = producción
DJANGO_DEBUG=1
# producción: localhost,hadmind.com.co,www.hadmind.com.co (localhost lo usa el healthcheck)
# host.docker.internal: lo usa el n8n de prueba en tu PC para llegar a Django (n8n/LEEME.md)
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,host.docker.internal
# producción: https://hadmind.com.co,https://www.hadmind.com.co
DJANGO_CSRF_TRUSTED_ORIGINS=

# Dirección del admin. Desarrollo: admin. Producción: una secreta (despliegue/LEEME.md)
ADMIN_URL=admin

# Clave secreta que n8n envía para crear artículos de la Bitácora.
# Generar una larga: python -c "import secrets; print(secrets.token_urlsafe(40))"
# Vacía = la API de la Bitácora rechaza todo.
N8N_API_TOKEN=

# Dirección pública del sitio, para los enlaces del correo de la Bitácora.
# Desarrollo: http://localhost:8000   Producción: https://hadmind.com.co
SITIO_URL=http://localhost:8000

# 1 = los visitantes ven solo "Estamos en remodelación"; el equipo con sesión
# en el admin ve el sitio completo. 0 = sitio público.
SITIO_EN_REMODELACION=0

# Solo en el VPS (docker-compose.prod.yml)
COMPOSE_PROJECT_NAME=hadmind-web
WEB_PORT=8003
