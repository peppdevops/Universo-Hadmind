POSTGRES_DB=hadmind
POSTGRES_USER=hadmind
POSTGRES_PASSWORD=cambia-esto
POSTGRES_HOST=db
POSTGRES_PORT=5432

DJANGO_SECRET_KEY=cambia-esto
# 1 = desarrollo, 0 = producción
DJANGO_DEBUG=1
# producción: localhost,hadmind.com.co,www.hadmind.com.co (localhost lo usa el healthcheck)
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# producción: https://hadmind.com.co,https://www.hadmind.com.co
DJANGO_CSRF_TRUSTED_ORIGINS=

# Solo en el VPS (docker-compose.prod.yml)
COMPOSE_PROJECT_NAME=hadmind-web
WEB_PORT=8003
